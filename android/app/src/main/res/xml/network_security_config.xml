<?xml version="1.0" encoding="utf-8"?>
<!--
  just_audio serves custom headers and cached audio through a loopback HTTP
  proxy. Permitting cleartext globally would be the easy fix but would also let
  the app talk plaintext to any host, so scope it to localhost only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
